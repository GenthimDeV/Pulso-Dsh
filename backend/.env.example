# Copiar a .env (no se sube): settings.py lo carga solo. En producción, definirlas en el panel del host.
DEBUG=True
SECRET_KEY=cambia-esto-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1
# Vacío = SQLite local. Producción (Neon): postgresql://usuario:clave@host/db?sslmode=require
DATABASE_URL=
# Producción (Render): DEBUG=False, SECRET_KEY generada, DATABASE_URL de Neon. ALLOWED_HOSTS se completa
# solo con RENDER_EXTERNAL_HOSTNAME; añade aquí solo dominios propios. Ver render.yaml.
